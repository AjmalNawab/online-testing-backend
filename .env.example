# ---------------------------------------------------------------------------
# online-test-backend environment. Copy to .env for local development.
# Never commit real values. In production set these in Railway (or your host).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# Public URL of this API (used in logs/docs)
APP_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API (your frontend URLs)
CORS_ORIGINS=http://localhost:3000

# Postgres connection string from Supabase (Project → Connect).
# Local dev: the direct connection works. Railway/hosted: use the *Session pooler*
# URL (IPv4). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_SSL=true

# Supabase project URL and *publishable* (public) key — used only to verify admin logins.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Supabase *secret* key (Settings → API Keys). Used only to create/remove admin
# accounts from the app. Server-side only — never put it in the frontend.
SUPABASE_SECRET_KEY=
# One-time code you choose (12+ characters). Needed on the /setup page to create
# the first administrator; setup switches itself off once an admin exists.
SETUP_CODE=

# Google Gemini (AI generation + AI-assisted grading). Leave empty to disable AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
AI_TIMEOUT_MS=180000
# Max AI calls per admin per 24h (cost guard)
AI_DAILY_LIMIT=100

# Background finalisation of expired attempts
EXPIRY_WORKER_ENABLED=true
EXPIRY_WORKER_INTERVAL_SECONDS=30

# Reverse proxies in front of the app (Railway: 1) — needed for correct client IPs in rate limiting
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=true
